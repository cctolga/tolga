// Icon and version info of "Tolga Player.exe" (CMake fills in the version: tolga.rc.in -> tolga.rc)
#include <winver.h>

IDI_ICON1 ICON "@TOLGA_RC_DIR@/tolga.ico"
1 24 "@TOLGA_RC_DIR@/tolga.manifest"   // RT_MANIFEST: UTF-8 code page, DPI awareness

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tolga C."
            VALUE "FileDescription",  "Tolga Player"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "Tolga Player"
            VALUE "LegalCopyright",   "Apache License 2.0"
            VALUE "OriginalFilename", "Tolga Player.exe"
            VALUE "ProductName",      "Tolga Player"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
